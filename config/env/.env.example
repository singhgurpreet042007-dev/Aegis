# ═══════════════════════════════════════════════════════════════
# AEGIS AI — ENVIRONMENT VARIABLES
# Copy this file to .env.development and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
APP_NAME=aegis-ai
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
APP_PORT=3000
API_PORT=4000
LOG_LEVEL=debug

# ── Database (PostgreSQL) ────────────────────────────────────
DATABASE_URL=postgresql://aegis:aegis_dev_password@localhost:5432/aegis_dev?schema=public
DIRECT_URL=postgresql://aegis:aegis_dev_password@localhost:5432/aegis_dev?schema=public

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Authentication ───────────────────────────────────────────
JWT_SECRET=your-jwt-secret-min-32-chars-replace-me
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars-replace-me
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── OAuth 2.0 Providers ─────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# ── AI Provider API Keys ────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
GOOGLE_GEMINI_API_KEY=your-gemini-api-key
GROK_API_KEY=your-grok-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
MISTRAL_API_KEY=your-mistral-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# ── Stripe Billing ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Object Storage (S3-compatible) ──────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=aegis-uploads
S3_REGION=us-east-1

# ── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=noreply@aegis-ai.com

# ── Sentry Error Tracking ───────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ── Vector Database ─────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
