{
  "name": "aegis-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise-Grade AI Productivity Platform",
  "license": "AGPL-3.0",
  "author": "Aegis AI Team",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "test:load": "k6 run tests/load/stress-test.js",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:migrate": "pnpm --filter database run migrate",
    "db:seed": "pnpm --filter database run seed",
    "db:studio": "pnpm --filter database run studio",
    "db:generate": "pnpm --filter database run generate",
    "db:reset": "pnpm --filter database run reset",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "eslint": "^9.22.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "next": "^15.1.0",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19"
      }
    }
  }
}
