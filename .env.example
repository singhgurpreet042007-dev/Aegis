# AegisAI Public Environment Configuration Template (Demo / Showcase)
# Copy to .env in your respective sub-packages

# Application Environment
NODE_ENV=development
PORT=3000

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://aegis_user:aegis_password@localhost:5432/aegis_ai?schema=public"

# Redis Cache & Pub/Sub
REDIS_HOST="localhost"
REDIS_PORT=6379

# JWT Auth Secret
JWT_SECRET="your_secure_random_jwt_secret_change_me_in_production"
JWT_EXPIRES_IN="7d"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NEXT_PUBLIC_WS_URL="ws://localhost:3000"
